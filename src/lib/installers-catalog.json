      "label": "文稿",
      "group": "common",
      "template": "$HOME/Documents"
    },
    {
      "id": "public",
      "label": "公共文件夹",
      "group": "common",
      "template": "$HOME/Public"
    },
    {
      "id": "library-downloads",
      "label": "资源库下载",
      "group": "other",
      "template": "$HOME/Library/Downloads"
    },
    {
      "id": "shared",
      "label": "用户共享",
      "group": "common",
      "template": "/Users/Shared"
    },
    {
      "id": "shared-downloads",
      "label": "共享下载",
      "group": "common",
      "template": "/Users/Shared/Downloads"
