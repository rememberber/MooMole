      "label": "Telegram 文件",
      "group": "other",
      "template": "$HOME/Library/Application Support/Telegram Desktop"
    },
    {
      "id": "telegram-downloads",
      "label": "Telegram 下载",
      "group": "other",
      "template": "$HOME/Downloads/Telegram Desktop"
